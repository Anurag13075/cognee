"""Ingest Google Tasks into cognee memory incrementally.

Install:
    pip install "cognee[google-tasks]"

This connector fetches the user's task lists and tasks via the Google Tasks API
and emits each task as a document row. Re-running the source only processes the
updated delta and uses the hard-delete column so tasks removed upstream are
forgotten automatically on the next sync.
"""

import asyncio

import cognee
from cognee.tasks.ingestion.connectors import google_tasks_source


async def main():
    source = google_tasks_source()

    result = await cognee.remember(
        source,
        dataset_name="google_tasks_demo",
        primary_key="id",
        write_disposition="merge",
        max_rows_per_table=0,
    )
    print(result)

    answer = await cognee.search(
        query_text="What tasks are still open this week?",
        datasets=["google_tasks_demo"],
    )
    print(answer)


if __name__ == "__main__":
    asyncio.run(main())
